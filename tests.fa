importer "principal" comme g

tester "rectangle"
  verifier_egal(g.aire_rectangle(4, 3), 12)
  verifier_egal(g.perimetre_rectangle(4, 3), 14)
  verifier_erreur(() => g.aire_rectangle(-1, 3))
fin

tester "cercle"
  verifier_egal(arrondir(g.aire_cercle(1), 4), 3.1416)
  verifier_egal(arrondir(g.perimetre_cercle(1), 4), 6.2832)
  verifier_egal(g.aire_cercle(0), 0)
  verifier_erreur(() => g.aire_cercle(-2))
fin

tester "triangle"
  verifier_egal(g.aire_triangle(10, 4), 20)
  verifier(g.triangle_possible(3, 4, 5))
  verifier(non g.triangle_possible(1, 2, 3))
  verifier_egal(g.aire_triangle_cotes(3, 4, 5), 6)
  verifier_erreur(() => g.aire_triangle_cotes(1, 2, 10))
  verifier_egal(g.hypotenuse(3, 4), 5)
fin

tester "distance et polygones"
  verifier_egal(g.distance({ x: 0, y: 0 }, { x: 3, y: 4 }), 5)
  soit carre = [{ x: 0, y: 0 }, { x: 2, y: 0 }, { x: 2, y: 2 }, { x: 0, y: 2 }]
  verifier_egal(g.aire_polygone(carre), 4)
  verifier_egal(g.perimetre_polygone(carre), 8)
  verifier_egal(g.aire_polygone([{ x: 0, y: 2 }, { x: 2, y: 2 }, { x: 2, y: 0 }, { x: 0, y: 0 }]), 4)
  verifier_erreur(() => g.aire_polygone([{ x: 0, y: 0 }, { x: 1, y: 1 }]))
fin
